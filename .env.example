# =====================================================
# Marketplace — environment configuration (example)
# Copy to .env and fill in real values. Never commit .env.
# =====================================================

# ---------- General ----------
NODE_ENV=development
APP_NAME=marketplace

# ---------- Backend ----------
BACKEND_PORT=3000
BACKEND_URL=http://localhost:3000
API_PREFIX=api

# ---------- Frontend ----------
FRONTEND_PORT=5173
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000/api

# ---------- PostgreSQL ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=marketplace
POSTGRES_DB=marketplace
# Full connection string used by TypeORM CLI (migrations)
DATABASE_URL=postgresql://marketplace:marketplace@localhost:5432/marketplace

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# ---------- Meilisearch ----------
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=masterKeyChangeMe

# ---------- JWT (placeholders — real auth arrives in Stage 2) ----------
JWT_ACCESS_SECRET=changeme_access_secret
JWT_ACCESS_EXPIRES_IN=15m
AUCTION_PURCHASE_WINDOW_MINUTES=30
JWT_REFRESH_SECRET=changeme_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# ---------- Google OAuth ----------
# Leave blank in local dev — Google login is cleanly disabled when unset,
# email/password auth is unaffected. Fill in to enable it (see README).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ---------- Admin bootstrap (used by `npm run seed:admin`) ----------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme_admin_password
ADMIN_NAME=Admin

# ---------- Rate limiting ----------
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100

# ---------- Logging ----------
LOG_LEVEL=debug
